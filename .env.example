# Copy this file to .env and fill it in. The dashboard's setup form writes to
# the same file, and keeps these comments intact.

# ---- AI provider (needed to research companies and write emails) ----
# ANY OpenAI-compatible provider works — Groq, OpenRouter, Together, a local
# Ollama, anything exposing /chat/completions. Only these three lines change.
#
# Default below is Groq (free tier, fast). Get a key: https://console.groq.com/keys
AI_API_KEY=your_groq_api_key_here
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=openai/gpt-oss-120b
#
# Not sure which model to use, or using a different provider? Run:
#   python check_models.py --list     # what does my endpoint offer?
#   python check_models.py --all      # which of them researches accurately?
# The AI only does research (which CV areas fit, one phrase quoted from the
# company's site); code verifies it and builds the email itself. The script
# scores each model on accuracy and on inventing nothing, then recommends one.
#
# If a model returns something unusable mid-run, research falls through to
# another model, then to keyword matching, before settling for standard wording.

# Cap on AI requests per minute, shared across all worker threads.
AI_MAX_RPM=800

# ---- Your info (needed for preparation) ----
YOUR_NAME=Your Full Name
YOUR_TARGET_ROLE=End-of-Study Internship

# Path to your companies list (.csv or .xlsx). The dashboard sets this when
# you upload a file; set it by hand if you run main.py directly.
COMPANIES_FILE_PATH=./companies.xlsx

# ---- Sending (only needed when you actually send) ----
# Two options — connect Google in the dashboard (recommended, nothing to put
# here), or use an app password below.
#
# For an app password:
# 1. Turn on 2-Step Verification: https://myaccount.google.com/security
# 2. Generate an app password: https://myaccount.google.com/apppasswords
# 3. Enable IMAP too (Gmail Settings > Forwarding and POP/IMAP) if you want
#    bounce checking over IMAP. The OAuth path doesn't need IMAP.
GMAIL_ADDRESS=you@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Your CV, attached to every application.
CV_FILE_PATH=./my_cv.pdf

# ---- Sending behaviour / anti-spam pacing ----
# Random delay range between each send, in seconds.
MIN_DELAY_SECONDS=45
MAX_DELAY_SECONDS=120
# Hard cap on emails sent per calendar day (UTC). Start LOW (10-15) for the
# first few days to warm up your Gmail account, then raise it.
MAX_EMAILS_PER_DAY=20

# ---- Preparation performance (safe to leave at defaults) ----
# How many companies are scraped + researched concurrently.
RESEARCH_WORKERS=3
# How many emails are drafted concurrently.
WRITER_WORKERS=2

# ---- Dashboard ----
# Signs the local dashboard's session cookie. Generated automatically on first
# run if absent — no need to set it yourself.
# DASHBOARD_SECRET=
