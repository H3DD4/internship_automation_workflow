# ---- AI provider ----
# Create your key at https://chat.b.ai/key
AI_KEY_PORTAL=https://chat.b.ai/key
AI_API_KEY=your_bai_api_key_here
# The portal is for keys; this is the OpenAI-compatible inference endpoint.
AI_BASE_URL=https://api.b.ai/v1
AI_MODEL=hy3
# Available: hy3, mimo-v2.5, glm-5.3-flash, qwen3.8-flash

# ---- Gmail ----
# Use a Gmail "App Password", NOT your normal Gmail password.
# 1. Turn on 2-Step Verification: https://myaccount.google.com/security
# 2. Generate an app password: https://myaccount.google.com/apppasswords
# 3. Make sure IMAP is enabled too (Gmail Settings > Forwarding and POP/IMAP)
#    — the same app password works for both sending (SMTP) and bounce checking (IMAP).
GMAIL_ADDRESS=you@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# ---- Your info ----
YOUR_NAME=Your Full Name
YOUR_TARGET_ROLE=End-of-Study Internship
CV_FILE_PATH=./my_cv.pdf

# ---- Sending behavior / anti-spam pacing ----
# Random delay range between each send, in seconds.
MIN_DELAY_SECONDS=45
MAX_DELAY_SECONDS=120
# Hard cap on emails sent per calendar day. Start LOW (10-15) for the first
# few days to warm up your Gmail account's sending reputation, then raise it.
MAX_EMAILS_PER_DAY=20

# ---- Pipeline performance (safe to leave at defaults) ----
# How many companies are scraped + researched concurrently in the background.
# Higher = faster, but more concurrent outbound requests to company websites
# and more concurrent Anthropic API calls. 3 is a good balance.
RESEARCH_WORKERS=3
# How many emails are drafted concurrently in the background. This only
# needs to keep slightly ahead of the send pacing, so it can stay lower.
WRITER_WORKERS=2
# Max number of fully-drafted, ready-to-send emails held in memory waiting
# for the sender. Small on purpose — there's no benefit to drafting far
# ahead of the pacing delay, and it keeps memory use flat regardless of how
# many companies are in your list.
READY_QUEUE_SIZE=3
