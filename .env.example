# Copy to .env next to docker-compose.yml, fill in, then:
#     docker compose up -d --build          ->  http://127.0.0.1:5050
#
# Everything a USER configures (AI keys, Gmail, CV, pacing, profile) is set in
# the app and stored per account, encrypted — not here.

# ---- Database (the "db" container) ----
POSTGRES_PASSWORD=change-me-to-a-long-random-string

# ---- Keys: generate with  python manage.py generate-keys  (keep them safe!) ----
# Losing ENCRYPTION_KEYS makes every saved API key and mail password unreadable.
SECRET_KEY=
ENCRYPTION_KEYS=

# ---- The platform administrator (signs in with this username) ----
# Single quotes keep special characters like $ exactly as typed.
ADMIN_USERNAME='admin'
ADMIN_PASSWORD='choose-a-long-password'

# ---- Address and sign-up ----
PUBLIC_BASE_URL=http://127.0.0.1:5050
SIGNUP_MODE=approval               # approval | open | closed (also in Admin → Platform)

# ---- Optional ----
# Google sign-in: or upload the OAuth client JSON in Admin → Platform.
# Authorised redirect URI on Google's side: <PUBLIC_BASE_URL>/oauth/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# APP_PORT=5050                    # the port on this machine
# PG_VOLUME=internship_pgdata      # reuse an existing database volume
#
# On a server with a domain (automatic HTTPS):  docker compose --profile https up -d --build
# DOMAIN=apply.example.com
# PUBLIC_BASE_URL=https://apply.example.com
# TRUST_PROXY=1
#
# Running without Docker (python dashboard/app.py) uses these instead:
# DATABASE_URL=postgresql+psycopg://internship:<POSTGRES_PASSWORD>@127.0.0.1:5433/internship
# APP_ENV=development
